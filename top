`timescale 1ns / 1ps


module top(
    input wire clk,
    input wire [4:0] sw,     
    output wire audio_pwm,   // The Sound Signal
    output wire audio_sd,    // The Amplifier Enable Signal
    output wire [6:0] seg,
    output wire [3:0] an,
    output wire debug_led
);

    wire play_c      = sw[0];
    wire play_d      = sw[1];
    wire play_e      = sw[2];
    wire play_f      = sw[3];
    wire play_melody = sw[4];

    reg [3:0] note_index;
    reg [16:0] clkdiv = 0; 
    always @(posedge clk) clkdiv <= clkdiv + 1;

    // Note Selection Logic
    always @(*) begin
        if (play_c)      note_index = 0;
        else if (play_d) note_index = 1;
        else if (play_e) note_index = 2;
        else if (play_f) note_index = 3;
        else if (play_melody) note_index = 4;
        else             note_index = 15; 
    end

    // Tone Generator
    wire tone_signal;
    tone_gen tone (
        .clk(clk),
        .enable(play_c | play_d | play_e | play_f | play_melody),
        .note_c(play_c),
        .note_d(play_d),
        .note_e(play_e),
        .note_f(play_f),
        .play_melody(play_melody),
        .buzzer_out(tone_signal)
    );

    // ----------------------------------------------------------
    // AUDIO OUTPUTS
    // ----------------------------------------------------------
    assign audio_pwm = tone_signal;  // Send sound to the Audio Jack
    assign audio_sd  = 1'b1;         // IMPORTANT: On Nexys4DDR, 1 = Enable Amp
                                     // (Wait! Check notes below*)

    assign debug_led = tone_signal;  // Keep LED 15 for visual test

    // Display
    display show (
        .clk(clkdiv[15]), 
        .note_index(note_index),
        .seg(seg),
        .an(an)
    );

endmodule
